# Copiez ce fichier en .env et remplissez vos valeurs. Ne publiez jamais le fichier .env.

# Clé de l'IA (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Meta / Facebook (voir README)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Facultatif : pour diffuser aussi sur Instagram
META_INSTAGRAM_USER_ID=
META_API_VERSION=v23.0
